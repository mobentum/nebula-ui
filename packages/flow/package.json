{
  "name": "@mobentum/nebula-flow",
  "version": "0.0.1",
  "license": "MIT",
  "packageManager": "pnpm@10.33.4",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./css/flow.css": {
      "style": "./css/flow.css",
      "default": "./css/flow.css"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && tsup --dts-only",
    "dev": "node scripts/build.mjs --watch",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@mobentum/nebula-ui": "workspace:*",
    "@xyflow/react": "^12.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@mobentum/nebula-eslint-config": "workspace:*",
    "@mobentum/nebula-tsconfig": "workspace:*",
    "@mobentum/nebula-ui": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "@xyflow/react": "^12.11.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.25.1",
    "jest-axe": "^11.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
