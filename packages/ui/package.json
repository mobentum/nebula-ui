{
  "name": "@mobentum/nebula-ui",
  "version": "1.1.1",
  "license": "MIT",
  "packageManager": "pnpm@10.33.4",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./css/tailwind.css": {
      "style": "./css/tailwind.css",
      "default": "./css/tailwind.css"
    },
    "./css/default-theme.css": {
      "style": "./css/default-theme.css",
      "default": "./css/default-theme.css"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && tsup --dts-only",
    "dev": "node scripts/build.mjs --watch",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "react-resizable-panels": "^4.11.2",
    "tailwind-merge": "^3.2.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@mobentum/nebula-eslint-config": "workspace:*",
    "@mobentum/nebula-tsconfig": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.28.1",
    "eslint": "^9.25.1",
    "jest-axe": "^11.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
